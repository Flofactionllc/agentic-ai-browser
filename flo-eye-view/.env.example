# Flo Eye View — local only. Copy to .env (gitignored).
# No keys are required for v1 Storm Ops / Fire Watch / MARC / Florida home.
# Do not commit real keys. Do not deploy publicly without explicit approval.

# Optional — commercial Cesium ion token only (never free Community for SaaS)
# Prefer Power Up panel (localStorage) for browser-side ion; use .env for Vite inject.
VITE_CESIUM_ION_TOKEN=

# Optional local API bind
FLO_EYE_API_HOST=127.0.0.1
FLO_EYE_API_PORT=5181

# Optional NASA FIRMS hotspot CSV (server-side only)
FIRMS_MAP_KEY=

# Optional TomTom — Flow Segment midpoints + relative-flow raster tile proxy
# (Power Up panel can also supply a browser BYOK key)
TOMTOM_API_KEY=

# Sell boundary — when set, /api/* requires access-code login
# FLO_EYE_ACCESS_CODE=flofaction-demo

# Commercial SKU: emergency | insurance | media | staffing | command
FLO_EYE_SKU=command
VITE_FLO_EYE_SKU=command

# Optional white-label
# FLO_EYE_BRAND_NAME=Flo Eye View
# FLO_EYE_BRAND_COMPANY=Flofaction

# Later
# AISSTREAM_API_KEY=
# OPENAI_API_KEY=
